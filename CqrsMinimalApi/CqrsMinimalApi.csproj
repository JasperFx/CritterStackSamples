<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CqrsMinimalApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.Http" Version="6.23.1" />
    <PackageReference Include="WolverineFx.Marten" Version="6.23.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <!-- Wolverine 6: core no longer ships Roslyn. Dynamic TypeLoadMode (the dev/test default)
       needs WolverineFx.RuntimeCompilation to compile handlers at runtime. We reference it ONLY
       in Debug builds, so a Release publish (what the Dockerfile produces for Production) ships
       WITHOUT Roslyn / WolverineFx.RuntimeCompilation. Production then runs the pre-generated code
       via TypeLoadMode.Static (see Program.cs).

       NOTE the condition uses '$(Configuration)' with the parentheses — a malformed condition such
       as '$Configuration)' silently never matches, which is why a conditional reference can appear
       to "still ship the assembly" (see GH-2900). The committed Internal/Generated code lets Release
       compile with no runtime compiler present. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.23.1" />
  </ItemGroup>

</Project>
