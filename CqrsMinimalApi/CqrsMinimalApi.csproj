<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CqrsMinimalApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.Http" Version="6.0.0-rc.2" />
    <PackageReference Include="WolverineFx.Marten" Version="6.0.0-rc.2" />
    <!-- Wolverine 6: core no longer ships Roslyn. Dynamic TypeLoadMode (the dev/test
         default) needs this package to compile handlers at runtime. Production AOT/Static
         deployments pre-generate via `codegen write` and drop this reference. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.0.0-rc.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

</Project>
