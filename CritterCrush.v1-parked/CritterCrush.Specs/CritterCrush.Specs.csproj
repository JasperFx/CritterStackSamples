<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit v3 on Microsoft.Testing.Platform, every test a Bobcat projected specification.
    ../global.json puts `dotnet test` into the platform's own mode, which Microsoft.Testing.Platform 2.x
    requires on the .NET 10 SDK.

    Until Bobcat 0.50 this was a self-executing Gherkin suite (Features/*.feature, a BobcatRunner Main,
    Bobcat.Alba and Bobcat.CritterStack 0.9.1). The Gherkin lane is gone (bobcat#471), so each scenario
    is now a [BobcatSpec] test of the same name; Bobcat.CritterStack is part of Bobcat itself, and the
    HTTP acts are plain Alba scenarios in CritterCrushSpec.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- The same version for all three Bobcat packages -->
    <BobcatVersion>1.0.0-rc.1</BobcatVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alba" Version="8.5.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />

    <PackageReference Include="Bobcat" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Generators" Version="$(BobcatVersion)" PrivateAssets="all" />
    <PackageReference Include="Bobcat.Xunit" Version="$(BobcatVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CritterCrush\CritterCrush.csproj" />
  </ItemGroup>

</Project>
