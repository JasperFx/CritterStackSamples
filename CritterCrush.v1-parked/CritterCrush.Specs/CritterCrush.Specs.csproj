<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bobcat" Version="0.9.1" />
    <PackageReference Include="Bobcat.Alba" Version="0.9.1" />
    <!-- Store-agnostic event-store helpers (reset, projection waits) — deliberately not
         Bobcat.Marten; the specs reach the store through JasperFx.Events abstractions. -->
    <PackageReference Include="Bobcat.CritterStack" Version="0.9.1" />
    <!-- The source generator: binds Gherkin steps and emits the Event Model source. -->
    <PackageReference Include="Bobcat.Generators" Version="0.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CritterCrush\CritterCrush.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Features\**\*.feature" />
  </ItemGroup>

</Project>
