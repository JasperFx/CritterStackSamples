<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bobcat specifications: ordinary xunit.v3 tests in [BobcatFeature] classes, rendered
       as specifications by Bobcat.Generators, on Microsoft.Testing.Platform. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <BobcatVersion>1.0.3</BobcatVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Bobcat" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Xunit" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Generators" Version="$(BobcatVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoanUnderwriting\LoanUnderwriting.csproj" />
  </ItemGroup>

</Project>
