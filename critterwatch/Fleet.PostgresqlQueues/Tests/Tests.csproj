<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fleet.PostgresqlQueues smoke battery. Thin by design: references the shared harness (the
       boot/wait/route-assertion machinery) plus this solution's AppHost (so Aspire generates the
       Projects.AppHost marker the generic fixture is closed over). See
       ../../Shared/CritterWatch.Samples.Testing. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 is its own test host on Microsoft.Testing.Platform; ../global.json opts dotnet test into it. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared Aspire.Hosting.Testing harness: CritterWatchAppHostFixture<TAppHost>,
         CritterWatchAboutOk(), WaitForServicesAsync(), the DockerRequired collection. -->
    <ProjectReference Include="..\..\Shared\CritterWatch.Samples.Testing\CritterWatch.Samples.Testing.csproj" />
    <!-- The AppHost — this reference is what makes Aspire emit Projects.AppHost for the fixture. -->
    <ProjectReference Include="..\AppHost\AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bobcat projected specs. An out-of-process Aspire suite has no in-process host for
         CritterStackSpec or WolverineSpec to stand on, so these specs are step helpers + SpecAssert. -->
    <PackageReference Include="Bobcat" />
    <PackageReference Include="Bobcat.Generators" PrivateAssets="all" />
    <PackageReference Include="Bobcat.Xunit" />
  </ItemGroup>

</Project>
