<Project>

  <!-- Central pin set for the CritterWatch samples island. Aligned to CritterWatch
       1.0.0-alpha.4's actual dependency closure (see CritterWatch's own
       Directory.Packages.props). Bump these together at release time, then re-run
       the per-solution Aspire test battery against the new local-feed packages. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CritterWatchVersion>1.0.0-alpha.4</CritterWatchVersion>
  </PropertyGroup>

  <ItemGroup Label="CritterWatch (local feed)">
    <PackageVersion Include="CritterWatch" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.SqlServer" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.Abstractions" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch.Http" Version="$(CritterWatchVersion)" />
  </ItemGroup>

  <ItemGroup Label="Wolverine (6.16.0 GA — matches CritterWatch main's closure; custom -cw pins dropped)">
    <!-- All on the published 6.16.0 stable release. The previous custom local-build pins are no longer
         needed: WolverineFx.Pubsub#3258 (leader-pinned shared subscription), and the -cw533/-cw3252 core +
         DB-transport fixes have all shipped in 6.16.0. CritterWatch main depends on >= 6.16.0-alpha.2, which
         6.16.0 satisfies (no downgrade). -->
    <PackageVersion Include="WolverineFx" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Http.Marten" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Polecat" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Http.Polecat" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.AmazonSqs" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Kafka" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Redis" Version="6.16.0" />
    <PackageVersion Include="WolverineFx.Pubsub" Version="6.16.0" />
  </ItemGroup>

  <ItemGroup Label="Event stores (latest GA stable — matches CritterWatch main's post-GA-bump closure)">
    <!-- CritterWatch main has moved to the GA stable event stores (Marten 9.12.0, Polecat 4.7.0,
         JasperFx 2.18.1), so the samples track the same latest-stable releases. -->
    <PackageVersion Include="Marten" Version="9.12.0" />
    <PackageVersion Include="Polecat" Version="4.7.0" />
    <PackageVersion Include="JasperFx" Version="2.18.1" />
    <PackageVersion Include="JasperFx.Events" Version="2.18.1" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.18.1" />
    <PackageVersion Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup Label="Aspire (host + container resources + testing)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetry (Metrics.Prometheus sample — meter-only services + Prometheus exporter)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.0-beta.1" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
