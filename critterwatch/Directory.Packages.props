<Project>

  <!-- Central pin set for the CritterWatch samples island. Aligned to CritterWatch
       1.0.0-rc.1's actual dependency closure (see CritterWatch's own
       Directory.Packages.props). CritterWatch 1.0.0-rc.1 is published to nuget.org,
       so the samples resolve everything from nuget.org — no local feed needed.
       Bump these together at release time, then re-run the per-solution Aspire battery. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CritterWatchVersion>1.0.0-rc.1</CritterWatchVersion>
  </PropertyGroup>

  <ItemGroup Label="CritterWatch (nuget.org)">
    <PackageVersion Include="CritterWatch" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.SqlServer" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.Abstractions" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch.Http" Version="$(CritterWatchVersion)" />
  </ItemGroup>

  <ItemGroup Label="Wolverine (6.23.1 GA — the exact version CritterWatch 1.0.0-rc.1 depends on)">
    <PackageVersion Include="WolverineFx" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Http.Marten" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Polecat" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Http.Polecat" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.AmazonSqs" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Kafka" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Redis" Version="6.23.1" />
    <PackageVersion Include="WolverineFx.Pubsub" Version="6.23.1" />
  </ItemGroup>

  <ItemGroup Label="Event stores (latest GA stable — satisfies CritterWatch 1.0.0-rc.1's closure)">
    <!-- Marten 9.20.1 / Polecat 5.7.0 are the latest stable releases and are >= what
         CritterWatch 1.0.0-rc.1 asks for (Marten 9.20.0, Polecat 5.7.0). JasperFx is on
         2.36.2 because Marten 9.20.1 requires it (CritterWatch itself only asks for 2.36.1). -->
    <PackageVersion Include="Marten" Version="9.20.1" />
    <PackageVersion Include="Polecat" Version="5.7.0" />
    <PackageVersion Include="JasperFx" Version="2.36.2" />
    <PackageVersion Include="JasperFx.Events" Version="2.36.2" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.36.2" />
    <PackageVersion Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup Label="Aspire (host + container resources + testing)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetry (Metrics.Prometheus sample — meter-only services + Prometheus exporter)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.0-beta.1" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

</Project>
