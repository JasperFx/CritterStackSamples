<Project>

  <!-- Central pin set for the CritterWatch samples island. Aligned to CritterWatch
       1.5.0's dependency closure (its nuspecs and CritterWatch's own Directory.Packages.props
       at the v1.5.0 tag). CritterWatch 1.5.0 is published to nuget.org, so the samples
       resolve everything from nuget.org — no local feed needed. Embedded.Sqlite used to carry
       its own nested island pinned to a local 1.1 pack; it inherits this one now.
       Bump these together at release time, then re-run the per-solution Aspire battery. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CritterWatchVersion>1.5.0</CritterWatchVersion>
  </PropertyGroup>

  <ItemGroup Label="CritterWatch (nuget.org)">
    <PackageVersion Include="CritterWatch" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.SqlServer" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.Sqlite" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.Services" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch.Http" Version="$(CritterWatchVersion)" />
  </ItemGroup>

  <ItemGroup Label="Wolverine (6.64.0 — exactly what CritterWatch 1.5.0 depends on)">
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Http.Marten" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Polecat" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Http.Polecat" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Fisher" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Http.Fisher" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.AmazonSqs" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Kafka" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Redis" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Pubsub" Version="6.64.0" />
  </ItemGroup>

  <ItemGroup Label="Event stores (exactly CritterWatch 1.5.0's closure)">
    <PackageVersion Include="Marten" Version="9.59.0" />
    <PackageVersion Include="Polecat" Version="5.50.0" />
    <PackageVersion Include="Fisher" Version="1.29.0" />
    <PackageVersion Include="JasperFx" Version="2.102.0" />
    <PackageVersion Include="JasperFx.Events" Version="2.102.0" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="2.102.0" />
    <PackageVersion Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup Label="Aspire (host + container resources + testing)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="9.5.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="9.5.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetry (Metrics.Prometheus sample — meter-only services + Prometheus exporter)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.0-beta.1" />
  </ItemGroup>

  <ItemGroup Label="Test stack (xUnit v3 on Microsoft.Testing.Platform 2.x; each solution's global.json opts dotnet test into it)">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- The shared harness is a library, not a test host: it takes xUnit's extensibility surface only. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Bobcat (projected specs; the same version for all three)">
    <PackageVersion Include="Bobcat" Version="1.0.0-alpha.1" />
    <PackageVersion Include="Bobcat.Generators" Version="1.0.0-alpha.1" />
    <PackageVersion Include="Bobcat.Xunit" Version="1.0.0-alpha.1" />
  </ItemGroup>

</Project>
