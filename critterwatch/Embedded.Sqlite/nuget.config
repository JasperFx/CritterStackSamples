<?xml version="1.0" encoding="utf-8"?>
<!--
  DELETE THIS FILE WHEN CRITTERWATCH 1.1 PUBLISHES. See Directory.Packages.props.

  Embedded mode is not on nuget.org yet, so the three CritterWatch packages come from a
  local folder feed. packageSourceMapping keeps everything else on nuget.org, so a local
  build cannot silently shadow an unrelated package.

  To produce the feed, run "dotnet pack" from a CritterWatch checkout for each of
  Wolverine.CritterWatch, CritterWatch.Services and CritterWatch.Services.Fisher, into
  ~/code/_cw_localfeed, with the version below and the EmbedFrontend property set to true.
  The exact command line is in this sample's README, where a shell comment can contain the
  double dashes that an XML comment cannot.

  EmbedFrontend is what puts the console's SPA in the package; without it the UI mounts but
  serves nothing.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cw-local" value="../../../_cw_localfeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="cw-local">
      <package pattern="CritterWatch.*" />
      <package pattern="Wolverine.CritterWatch" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
