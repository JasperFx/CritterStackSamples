<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ TEMPORARY — the local feed is the release-cycle STAGING mechanism.

  Embedded mode (CritterWatch#1139) is not on nuget.org yet, so this sample restores the
  CritterWatch packages from a local folder feed while everything else comes from nuget.org.
  Pack them with:

      dotnet pack src/CritterWatch.Services.Fisher/CritterWatch.Services.Fisher.csproj \
                  src/CritterWatch.Services/CritterWatch.Services.csproj \
                  src/Wolverine.CritterWatch/Wolverine.CritterWatch.csproj \
        -c Release -o ~/code/_cw_localfeed -p:Version=1.1.0-embedded.3

  packageSourceMapping is what keeps this honest: ONLY the CritterWatch ids come from the local
  feed, so a stale local pack cannot silently shadow a published Wolverine or Fisher.

  When 1.1 publishes, DELETE this file along with the sibling Directory.Build.props and
  Directory.Packages.props — the sample then restores from nuget.org like every other one.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="cw-local" value="../../../_cw_localfeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="cw-local">
      <package pattern="CritterWatch.*" />
      <package pattern="Wolverine.CritterWatch" />
      <package pattern="Wolverine.CritterWatch.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
