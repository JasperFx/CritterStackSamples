<Project>

  <!-- ============================================================================
       ⚠️ NESTED CONFIG ISLAND — DELETE THIS FILE (and nuget.config beside it) WHEN
       CRITTERWATCH 1.1 PUBLISHES.

       Embedded mode ships in 1.1 and is not on nuget.org yet, so this one sample
       pins the CritterWatch packages to a LOCAL FOLDER FEED. Every other sample in
       the critterwatch island is clone-and-F5 against nuget.org alone, and this
       one goes back to that the moment 1.1 is public: delete these two files and
       it inherits the island's parent Directory.Packages.props.

       That is the whole migration. There is nothing else machine-specific here.
       ============================================================================ -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Bump when re-packing; a stale pack in the NuGet global cache silently
         shadows a newer one of the same version (CritterWatch #997). -->
    <CritterWatchVersion>1.1.0-embedded.5</CritterWatchVersion>
  </PropertyGroup>

  <ItemGroup Label="CritterWatch — LOCAL FEED until 1.1 publishes">
    <PackageVersion Include="CritterWatch.Sqlite" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="CritterWatch.Services" Version="$(CritterWatchVersion)" />
    <PackageVersion Include="Wolverine.CritterWatch" Version="$(CritterWatchVersion)" />
  </ItemGroup>

  <ItemGroup Label="Critter Stack">
    <PackageVersion Include="WolverineFx" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.Fisher" Version="6.34.0" />
    <PackageVersion Include="WolverineFx.Http.Fisher" Version="6.34.0" />
    <!-- ⚠️ Embedded generates the console's chains at RUNTIME (the host owns the
         runtime, so the console cannot use its own static registries). -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.34.0" />
    <PackageVersion Include="Fisher" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

</Project>
