<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET Aspire orchestration host — the F5 surface. Provisions the single SQL Server 2025 container
       (event store + DB-queue transport in one) and launches the console + every monitored service as
       project resources. The Aspire.AppHost.Sdk generates the Projects.* marker types (one per
       ProjectReference below) that AddProject<T>() and the Tests' CritterWatchAppHostFixture<Projects.AppHost>
       consume. -->

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>fleet-sqlserverqueues-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <!-- One container: SQL Server (no broker — the transport IS the database). -->
    <PackageReference Include="Aspire.Hosting.SqlServer" />
  </ItemGroup>

  <!-- One ProjectReference per launched resource. Aspire needs these so it can emit each Projects.* type
       and locate the built assembly to run. -->
  <ItemGroup>
    <ProjectReference Include="..\CritterWatchConsole\CritterWatchConsole.csproj" />
    <ProjectReference Include="..\TripService\TripService.csproj" />
    <ProjectReference Include="..\TripPublisher\TripPublisher.csproj" />
    <ProjectReference Include="..\RepairShop\RepairShop.csproj" />
    <ProjectReference Include="..\Incidents.Service\Incidents.Service.csproj" />
    <ProjectReference Include="..\Incidents.Publisher\Incidents.Publisher.csproj" />
  </ItemGroup>

</Project>
