<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The standalone CritterWatch console (Polecat / SQL Server flavor) — the monitoring dashboard the
       whole fleet reports to. It owns its OWN Polecat store on SQL Server (the console's event/document
       storage) and listens for monitored services on the SQL Server database-QUEUE control channel.
       Consumes the PACKED `CritterWatch.SqlServer` NuGet exactly as an operator would (the package bundles
       the SPA, endpoints, SignalR hub, and the Polecat AddCritterWatch/UseCritterWatch hosting
       extensions). -->

  <ItemGroup>
    <ProjectReference Include="..\Fleet.Common\Fleet.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Polecat / SQL Server flavor of the console package. -->
    <PackageReference Include="CritterWatch.SqlServer" />

    <!-- The console wires the SQL Server DB-queue control channel itself, so it needs the SQL Server
         transport package. -->
    <PackageReference Include="WolverineFx.SqlServer" />

    <!-- The CritterWatch.SqlServer package ships NO committed generated handler/endpoint code (unlike the
         Marten flavor), so the standalone Polecat console runs its handler/endpoint pipeline under dynamic
         Roslyn codegen — the runtime compiler must be present (option (b) in the package's hosting-extension
         remarks). -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

</Project>
