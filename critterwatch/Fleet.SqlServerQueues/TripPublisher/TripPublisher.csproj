<Project Sdk="Microsoft.NET.Sdk">

  <!-- TripPublisher — the console driver that synthesizes trip traffic. It has no event store; it just
       publishes commands over the SQL Server queue transport and handles the ContinueTrip callback to keep
       each trip advancing. Still a monitored service (AddCritterWatchMonitoring), so it appears in the
       console too. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TripMessages\TripMessages.csproj" />
    <ProjectReference Include="..\Fleet.Common\Fleet.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wolverine.CritterWatch" />
    <PackageReference Include="WolverineFx.SqlServer" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

</Project>
