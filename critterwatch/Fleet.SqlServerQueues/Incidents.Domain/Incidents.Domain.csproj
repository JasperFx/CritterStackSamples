<Project Sdk="Microsoft.NET.Sdk">

  <!-- Incidents.Domain — shared aggregates, events, commands, and the IncidentsByCategory multi-stream
       projection. Split into its own library so a future MultiStoreHost sample can compose the domain
       alongside Trips without dragging in the Incidents.Service web/worker wiring.

       Unlike the Marten flagship's Incidents.Domain, this references Polecat (not Marten): the projection
       base classes live in Polecat.Projections, and Polecat's bundled JasperFx.Events.SourceGenerator
       analyzer must run in THIS assembly to emit the partial projection's apply dispatcher (transitive
       package refs don't propagate analyzers, so the Polecat ref must be direct here). -->

  <PropertyGroup>
    <RootNamespace>Incidents.Domain</RootNamespace>
    <AssemblyName>Incidents.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JasperFx" />
    <PackageReference Include="Polecat" />
  </ItemGroup>

</Project>
