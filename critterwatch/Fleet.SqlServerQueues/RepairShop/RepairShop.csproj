<Project Sdk="Microsoft.NET.Sdk">

  <!-- RepairShop — the second monitored Polecat / SQL Server service. TripService routes RepairRequested
       here on a critical breakdown; RepairShop conducts repairs (via a local queue per state) and replies
       RepairsCompleted. Demonstrates cross-service message flow over the SQL Server queue transport that
       CritterWatch's routing view shows. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TripMessages\TripMessages.csproj" />
    <ProjectReference Include="..\Fleet.Common\Fleet.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wolverine.CritterWatch" />
    <PackageReference Include="WolverineFx.SqlServer" />
    <PackageReference Include="WolverineFx.Polecat" />
    <PackageReference Include="Polecat" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

</Project>
