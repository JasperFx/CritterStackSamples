<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Wolverine 7 with saga compensation (wolverine PR #5659) is not on nuget.org yet. Pack it locally into
       this folder first; see README.md. Everything else comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="wolverine-local" value="../../local-packs/wolverine-eval" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="wolverine-local">
      <package pattern="WolverineFx" />
      <package pattern="WolverineFx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
