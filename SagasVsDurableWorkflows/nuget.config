<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- TEMPORARY: Wolverine 7.0.0-alpha.3 until nuget.org serves it. Packed from wolverine main 3329c80d0 into
       ~/code/local-packs/wolverine-7.0.0-alpha.3. Everything else comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="wolverine-local" value="../../local-packs/wolverine-7.0.0-alpha.3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="wolverine-local">
      <package pattern="WolverineFx" />
      <package pattern="WolverineFx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
