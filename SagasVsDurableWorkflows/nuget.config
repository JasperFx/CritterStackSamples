<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Everything, Wolverine 7.0.0-alpha.3 included, comes from nuget.org -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
