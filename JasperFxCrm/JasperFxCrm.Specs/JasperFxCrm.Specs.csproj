<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bobcat specifications: ordinary xunit.v3 tests in [BobcatFeature] classes, rendered
       as Given / When / Then by Bobcat.Generators, on Microsoft.Testing.Platform. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Render statement-level Shouldly assertions as specification steps. -->
    <BobcatProjectAssertions>true</BobcatProjectAssertions>
    <BobcatVersion>1.0.1</BobcatVersion>
    <WolverineFxBobcatVersion>6.61.0</WolverineFxBobcatVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Bobcat" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Xunit" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Generators" Version="$(BobcatVersion)" />
    <PackageReference Include="WolverineFx.Bobcat" Version="$(WolverineFxBobcatVersion)" />
    <PackageReference Include="WolverineFx.Bobcat.Http" Version="$(WolverineFxBobcatVersion)-alpha.1" />
    <PackageReference Include="Alba" Version="9.0.0-rc.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JasperFxCrm\JasperFxCrm.csproj" />
  </ItemGroup>

</Project>
