<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0"/>
        <!-- Wolverine 6 moved Roslyn runtime compilation out of core into this package;
             the Dynamic TypeLoadMode used in dev/test needs it to compile handlers. -->
        <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.30.0" />
        <PackageReference Include="WolverineFx.Http.Marten" Version="6.30.0" />
    </ItemGroup>

</Project>
