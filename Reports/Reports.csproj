<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Marten" Version="9.29.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <!-- Wolverine 6 moved Roslyn runtime compilation out of core into this package;
         the Dynamic TypeLoadMode used in dev/test needs it to compile handlers. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.30.0" />
    <PackageReference Include="WolverineFx.Http" Version="6.30.0" />
    <PackageReference Include="WolverineFx.Marten" Version="6.30.0" />
  </ItemGroup>

</Project>
