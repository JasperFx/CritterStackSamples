<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit v3 on Microsoft.Testing.Platform, with Bobcat's projected specs beside the original
    tests. ../global.json puts `dotnet test` into the platform's own mode, which
    Microsoft.Testing.Platform 2.x requires on the .NET 10 SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AssemblyName>BankAccountES.Tests</AssemblyName>
    <RootNamespace>BankAccountES.Tests</RootNamespace>
    <!-- The same version for all three Bobcat packages -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <BobcatVersion>1.0.0-rc.1</BobcatVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alba" Version="8.5.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />

    <PackageReference Include="Bobcat" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Generators" Version="$(BobcatVersion)" PrivateAssets="all" />
    <PackageReference Include="Bobcat.Xunit" Version="$(BobcatVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BankAccountES.csproj" />
  </ItemGroup>

</Project>
