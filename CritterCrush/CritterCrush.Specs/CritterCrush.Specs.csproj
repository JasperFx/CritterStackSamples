<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit v3 on Microsoft.Testing.Platform 2, with every spec a Bobcat projected specification.
    ../global.json puts `dotnet test` into the platform's own mode, which Microsoft.Testing.Platform 2.x
    requires on the .NET 10 SDK.

    Bobcat 1.0 has no runner of its own any more: Bobcat.Mtp (and with it the generated Main and
    BobcatGenerateEntryPoint) and the Gherkin lane are gone (bobcat#471), so xUnit owns the entry point
    with nothing to opt out of. Bobcat.Alba is gone too (last 0.41.0): HTTP acts are Alba scenarios
    driven from CritterCrushSpec.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- The same version for all three Bobcat packages -->
    <BobcatVersion>1.0.0-alpha.1</BobcatVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Alba" Version="8.5.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />

    <PackageReference Include="Bobcat" Version="$(BobcatVersion)" />
    <PackageReference Include="Bobcat.Generators" Version="$(BobcatVersion)" PrivateAssets="all" />
    <PackageReference Include="Bobcat.Xunit" Version="$(BobcatVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CritterCrush\CritterCrush.csproj" />
  </ItemGroup>

</Project>
