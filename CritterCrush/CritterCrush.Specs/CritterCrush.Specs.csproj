<Project Sdk="Microsoft.NET.Sdk">

  <!-- The 0.10.0 zero-ceremony setup (bobcat #207): no hand-written Main. Bobcat.Generators
       sees Bobcat.Mtp referenced with no entry point declared and emits one; resources are
       registered on a [BobcatConfiguration] method. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bobcat" Version="0.11.0" />
    <PackageReference Include="Bobcat.Mtp" Version="0.11.0" />
    <PackageReference Include="Bobcat.Generators" Version="0.11.0" />
    <PackageReference Include="Bobcat.CritterStack" Version="0.11.0" />
    <PackageReference Include="Bobcat.Alba" Version="0.11.0" />
    <AdditionalFiles Include="Features/**/*.feature" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CritterCrush\CritterCrush.csproj" />
  </ItemGroup>

</Project>
